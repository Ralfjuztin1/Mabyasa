diff --git a/Scripts/Managers/InventoryManager.gd b/Scripts/Managers/InventoryManager.gd
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/Scripts/Managers/InventoryManager.gd
@@ -0,0 +1,215 @@
+extends Node
+
+## Account-owned food inventory shared by exploration, market UI and battles.
+signal inventory_changed
+signal battle_food_selected(item_id: String)
+
+const FOOD_DATABASE: Dictionary = {
+	"tibuk_tibuk": {
+		"id": "tibuk_tibuk", "name": "Tibuk-tibuk", "price": 15,
+		"heal_amount": 10, "heal_per_turn": 0, "duration": 0,
+		"description": "A small sweet treat. Restores 10 HP immediately."
+	},
+	"tamales": {
+		"id": "tamales", "name": "Tamales", "price": 30,
+		"heal_amount": 25, "heal_per_turn": 0, "duration": 0,
+		"description": "A filling local dish. Restores 25 HP immediately."
+	},
+	"bringhe": {
+		"id": "bringhe", "name": "Bringhe", "price": 45,
+		"heal_amount": 0, "heal_per_turn": 10, "duration": 2,
+		"description": "Restores 10 HP after each of your next 2 enemy turns."
+	},
+	"bulanglang": {
+		"id": "bulanglang", "name": "Bulanglang", "price": 60,
+		"heal_amount": 0, "heal_per_turn": 12, "duration": 3,
+		"description": "Restores 12 HP after each of your next 3 enemy turns."
+	},
+	"sisig": {
+		"id": "sisig", "name": "Sisig", "price": 85,
+		"heal_amount": 40, "heal_per_turn": 0, "duration": 0,
+		"description": "A hearty meal. Restores 40 HP immediately."
+	}
+}
+
+## Food ID -> quantity. This dictionary is serialized in each account's save.
+var food_quantities: Dictionary = {}
+var _active_menu: Node = null
+
+
+func _unhandled_input(event: InputEvent) -> void:
+	if not (event is InputEventKey):
+		return
+	var key_event: InputEventKey = event as InputEventKey
+	if not key_event.pressed or key_event.echo:
+		return
+	if is_instance_valid(_active_menu):
+		if key_event.keycode == KEY_ESCAPE:
+			_active_menu.queue_free()
+			get_viewport().set_input_as_handled()
+		return
+	if key_event.keycode == KEY_I:
+		if BattleManager == null or not BattleManager.battle_active:
+			open_inventory()
+			get_viewport().set_input_as_handled()
+
+
+func get_food_database() -> Dictionary:
+	return FOOD_DATABASE.duplicate(true)
+
+
+func get_food(item_id: String) -> Dictionary:
+	var value: Variant = FOOD_DATABASE.get(item_id, {})
+	if value is Dictionary:
+		return (value as Dictionary).duplicate(true)
+	return {}
+
+
+func get_quantity(item_id: String) -> int:
+	return maxi(int(food_quantities.get(item_id, 0)), 0)
+
+
+func get_total_food_count() -> int:
+	var total: int = 0
+	for value: Variant in food_quantities.values():
+		total += maxi(int(value), 0)
+	return total
+
+
+func get_owned_foods() -> Dictionary:
+	var result: Dictionary = {}
+	for key: Variant in food_quantities.keys():
+		var item_id: String = str(key)
+		var quantity: int = get_quantity(item_id)
+		if quantity > 0 and FOOD_DATABASE.has(item_id):
+			result[item_id] = quantity
+	return result
+
+
+func can_buy_food(item_id: String, quantity: int = 1) -> bool:
+	if not FOOD_DATABASE.has(item_id) or quantity < 1 or quantity > 99:
+		return false
+	var food: Dictionary = FOOD_DATABASE[item_id]
+	var price: int = int(food.get("price", 0)) * quantity
+	return PlayerProgression != null and PlayerProgression.gold >= price
+
+
+func buy_food(item_id: String, quantity: int = 1) -> bool:
+	if not can_buy_food(item_id, quantity):
+		return false
+	var food: Dictionary = FOOD_DATABASE[item_id]
+	var total_cost: int = int(food.get("price", 0)) * quantity
+	if not PlayerProgression.spend_gold(total_cost):
+		return false
+	food_quantities[item_id] = get_quantity(item_id) + quantity
+	inventory_changed.emit()
+	_request_account_save()
+	return true
+
+
+func consume_food(item_id: String) -> bool:
+	if not FOOD_DATABASE.has(item_id) or get_quantity(item_id) <= 0:
+		return false
+	var remaining: int = get_quantity(item_id) - 1
+	if remaining <= 0:
+		food_quantities.erase(item_id)
+	else:
+		food_quantities[item_id] = remaining
+	inventory_changed.emit()
+	_request_account_save()
+	return true
+
+
+## Outside combat, timed food's full listed healing is applied at once. In
+## combat, BattleManager handles action locks and the enemy's response.
+func use_food(item_id: String) -> bool:
+	if not FOOD_DATABASE.has(item_id) or get_quantity(item_id) <= 0:
+		return false
+	if BattleManager != null and BattleManager.battle_active:
+		return BattleManager.player_use_food(item_id)
+	if PlayerProgression == null:
+		return false
+
+	var food: Dictionary = get_food(item_id)
+	var total_healing: int = int(food.get("heal_amount", 0)) + (
+		int(food.get("heal_per_turn", 0)) * int(food.get("duration", 0))
+	)
+	PlayerProgression.ensure_hp_initialized()
+	if PlayerProgression.current_hp >= PlayerProgression.get_total_max_hp():
+		return false
+	if not consume_food(item_id):
+		return false
+	PlayerProgression.heal(total_healing)
+	_request_account_save()
+	return true
+
+
+func open_inventory() -> void:
+	_open_menu("inventory")
+
+
+func open_market() -> void:
+	_open_menu("market")
+
+
+func open_battle_food_picker() -> void:
+	_open_menu("battle")
+
+
+func _open_menu(mode: String) -> void:
+	if is_instance_valid(_active_menu):
+		_active_menu.queue_free()
+		_active_menu = null
+
+	var packed: PackedScene = load("res://Scenes/UI/FoodMenu.tscn") as PackedScene
+	if packed == null:
+		push_error("[INVENTORY] Could not load FoodMenu.tscn.")
+		return
+	var menu: Node = packed.instantiate()
+	menu.set("mode", mode)
+	if menu.has_signal("food_selected"):
+		menu.food_selected.connect(_on_menu_food_selected)
+	menu.tree_exited.connect(_on_menu_closed.bind(menu))
+	_active_menu = menu
+	get_tree().root.add_child(menu)
+
+
+func _on_menu_food_selected(item_id: String) -> void:
+	battle_food_selected.emit(item_id)
+
+
+func _on_menu_closed(menu: Node) -> void:
+	if _active_menu == menu:
+		_active_menu = null
+
+
+func get_save_data() -> Dictionary:
+	return {"food_quantities": food_quantities.duplicate(true)}
+
+
+func load_save_data(data: Dictionary) -> void:
+	food_quantities.clear()
+	var saved: Variant = data.get("food_quantities", {})
+	if saved is Dictionary:
+		for key: Variant in (saved as Dictionary).keys():
+			var item_id: String = str(key)
+			var quantity: int = maxi(int((saved as Dictionary).get(key, 0)), 0)
+			if FOOD_DATABASE.has(item_id) and quantity > 0:
+				food_quantities[item_id] = quantity
+	inventory_changed.emit()
+
+
+## Called at login/logout before restoring another account's own save.
+## This method deliberately does not request a save.
+func reset_for_account() -> void:
+	# Never leave the previous account's inventory visible during login swap.
+	if is_instance_valid(_active_menu):
+		_active_menu.queue_free()
+		_active_menu = null
+	food_quantities.clear()
+	inventory_changed.emit()
+
+
+func _request_account_save() -> void:
+	if GameManager != null and GameManager.has_method("request_save"):
+		GameManager.request_save()

diff --git a/Scenes/UI/FoodMenu.gd b/Scenes/UI/FoodMenu.gd
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/Scenes/UI/FoodMenu.gd
@@ -0,0 +1,202 @@
+extends CanvasLayer
+
+signal food_selected(item_id: String)
+
+## Supported modes: inventory, market, battle.
+var mode: String = "inventory"
+var _list: VBoxContainer
+var _gold_label: Label
+var _message_label: Label
+var _title_label: Label
+var _updating: bool = false
+
+
+func _ready() -> void:
+	layer = 90
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	_build_interface()
+	InventoryManager.inventory_changed.connect(_refresh)
+	if PlayerProgression != null:
+		PlayerProgression.stats_changed.connect(_refresh)
+	_refresh()
+
+
+func _build_interface() -> void:
+	var dim: ColorRect = ColorRect.new()
+	dim.color = Color(0.015, 0.02, 0.025, 0.78)
+	dim.mouse_filter = Control.MOUSE_FILTER_STOP
+	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(dim)
+
+	var center: CenterContainer = CenterContainer.new()
+	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	add_child(center)
+
+	var panel: PanelContainer = PanelContainer.new()
+	panel.custom_minimum_size = Vector2(760, 510)
+	panel.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
+	panel.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	center.add_child(panel)
+
+	var margins: MarginContainer = MarginContainer.new()
+	margins.add_theme_constant_override("margin_left", 20)
+	margins.add_theme_constant_override("margin_right", 20)
+	margins.add_theme_constant_override("margin_top", 16)
+	margins.add_theme_constant_override("margin_bottom", 16)
+	panel.add_child(margins)
+
+	var layout: VBoxContainer = VBoxContainer.new()
+	layout.add_theme_constant_override("separation", 12)
+	margins.add_child(layout)
+
+	var header: HBoxContainer = HBoxContainer.new()
+	header.add_theme_constant_override("separation", 14)
+	layout.add_child(header)
+
+	_title_label = Label.new()
+	_title_label.add_theme_font_size_override("font_size", 28)
+	_title_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	header.add_child(_title_label)
+
+	_gold_label = Label.new()
+	_gold_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	_gold_label.add_theme_font_size_override("font_size", 18)
+	header.add_child(_gold_label)
+
+	var close_button: Button = Button.new()
+	close_button.text = "Close"
+	close_button.custom_minimum_size = Vector2(86, 36)
+	close_button.pressed.connect(queue_free)
+	header.add_child(close_button)
+
+	layout.add_child(HSeparator.new())
+	var scroll: ScrollContainer = ScrollContainer.new()
+	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scroll.custom_minimum_size = Vector2(0, 360)
+	layout.add_child(scroll)
+
+	_list = VBoxContainer.new()
+	_list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	_list.add_theme_constant_override("separation", 8)
+	scroll.add_child(_list)
+
+	_message_label = Label.new()
+	_message_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	_message_label.modulate = Color(0.84, 0.82, 0.72, 1.0)
+	layout.add_child(_message_label)
+
+
+func _refresh() -> void:
+	if not is_instance_valid(_list) or _updating:
+		return
+	_updating = true
+	match mode:
+		"market":
+			_title_label.text = "Palengke"
+			_message_label.text = "Buy local food using Gold earned from battles and quests."
+		"battle":
+			_title_label.text = "Choose Food"
+			_message_label.text = "Eating uses your turn. The enemy still attacks, and timed healing triggers after enemy turns."
+		_:
+			_title_label.text = "Food Inventory"
+			_message_label.text = "Outside battle, food restores its full listed healing amount."
+	_gold_label.text = "Gold: %d" % PlayerProgression.gold
+
+	for child: Node in _list.get_children():
+		_list.remove_child(child)
+		child.queue_free()
+
+	var database: Dictionary = InventoryManager.get_food_database()
+	var displayed: int = 0
+	for key: Variant in database.keys():
+		var item_id: String = str(key)
+		var food: Dictionary = database[item_id]
+		var quantity: int = InventoryManager.get_quantity(item_id)
+		if mode != "market" and quantity <= 0:
+			continue
+		displayed += 1
+		_add_food_row(item_id, food, quantity)
+
+	if displayed == 0:
+		var empty: Label = Label.new()
+		empty.text = "Your food bag is empty. Visit the palengke to buy something."
+		empty.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		empty.custom_minimum_size = Vector2(0, 70)
+		_list.add_child(empty)
+	_updating = false
+
+
+func _add_food_row(item_id: String, food: Dictionary, quantity: int) -> void:
+	var card: PanelContainer = PanelContainer.new()
+	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	_list.add_child(card)
+
+	var row: HBoxContainer = HBoxContainer.new()
+	row.add_theme_constant_override("separation", 12)
+	card.add_child(row)
+
+	var text_column: VBoxContainer = VBoxContainer.new()
+	text_column.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	row.add_child(text_column)
+
+	var name_label: Label = Label.new()
+	name_label.text = "%s   x%d" % [str(food.get("name", item_id)), quantity]
+	name_label.add_theme_font_size_override("font_size", 18)
+	text_column.add_child(name_label)
+
+	var detail_label: Label = Label.new()
+	detail_label.text = "%s   •   %d Gold" % [
+		str(food.get("description", "")), int(food.get("price", 0))
+	]
+	detail_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	detail_label.modulate = Color(0.83, 0.82, 0.76, 1.0)
+	text_column.add_child(detail_label)
+
+	match mode:
+		"market":
+			var buy_button: Button = Button.new()
+			buy_button.text = "Buy"
+			buy_button.custom_minimum_size = Vector2(95, 38)
+			buy_button.disabled = not InventoryManager.can_buy_food(item_id)
+			buy_button.pressed.connect(_on_buy_pressed.bind(item_id))
+			row.add_child(buy_button)
+		"battle":
+			var select_button: Button = Button.new()
+			select_button.text = "Eat"
+			select_button.custom_minimum_size = Vector2(95, 38)
+			select_button.pressed.connect(_on_select_pressed.bind(item_id))
+			row.add_child(select_button)
+		_:
+			var use_button: Button = Button.new()
+			use_button.text = "Use"
+			use_button.custom_minimum_size = Vector2(95, 38)
+			use_button.pressed.connect(_on_use_pressed.bind(item_id))
+			row.add_child(use_button)
+
+
+func _on_buy_pressed(item_id: String) -> void:
+	var purchased: bool = InventoryManager.buy_food(item_id)
+	_refresh()
+	if purchased:
+		_message_label.text = "Purchased %s." % InventoryManager.get_food(item_id).get("name", item_id)
+	else:
+		_message_label.text = "Not enough Gold to buy that food."
+
+
+func _on_select_pressed(item_id: String) -> void:
+	if InventoryManager.get_quantity(item_id) <= 0:
+		_message_label.text = "You do not have that food anymore."
+		_refresh()
+		return
+	food_selected.emit(item_id)
+	queue_free()
+
+
+func _on_use_pressed(item_id: String) -> void:
+	if InventoryManager.use_food(item_id):
+		queue_free()
+	else:
+		_message_label.text = "You cannot use that food right now, or your HP is already full."
+		_refresh()

