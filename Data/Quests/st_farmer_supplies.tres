[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://Scripts/Quest/QuestData.gd" id="1_quest"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestReward.gd" id="2_reward"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestStep.gd" id="3_step"]

[sub_resource type="Resource" id="Reward"]
script = ExtResource("2_reward")
exp = 35
gold = 15

[sub_resource type="Resource" id="Demo"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Farmer"
required_count = 1
validation_type = "solve_puzzle"
validation_target = "st_farmer_world_numbers_learned"

[sub_resource type="Resource" id="PlantNine"]
script = ExtResource("3_step")
type = "interact_object"
target = "st_farmer_field_completed"
required_count = 9
validation_type = "none"
validation_target = ""

[sub_resource type="Resource" id="Turnin"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Farmer"
required_count = 1
validation_type = "solve_puzzle"
validation_target = "st_farmer_world_report_done"

[resource]
script = ExtResource("1_quest")
quest_id = "st_farmer_supplies"
title = "Plant the Farmer's Fields"
description = "Talk to Farmer, learn apat/lima/anam in the real garden, then plant nine fields in any order. Each field has nine planting spots. Return to Farmer when every field is finished."
rewards = SubResource("Reward")
steps = Array[ExtResource("3_step")]([SubResource("Demo"), SubResource("PlantNine"), SubResource("Turnin")])
quest_giver_id = "Farmer"
quest_turn_in_id = "Farmer"
is_main_quest = true
