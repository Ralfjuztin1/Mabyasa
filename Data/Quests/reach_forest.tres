[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://Scripts/Quest/QuestData.gd" id="1_quest"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestReward.gd" id="2_reward"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestStep.gd" id="3_step"]

[sub_resource type="Resource" id="ReachForestReward"]
script = ExtResource("2_reward")
exp = 0
gold = 0

[sub_resource type="Resource" id="ReachForestStep"]
script = ExtResource("3_step")
type = "reach_location"
target = "forest"
required_count = 1
validation_type = "none"
validation_target = ""

[resource]
script = ExtResource("1_quest")
quest_id = "reach_forest"
title = "Enter the Forest"
description = "Chief has approved you to leave the village. Follow the path to the Forest Gate and enter the Forest."
rewards = SubResource("ReachForestReward")
steps = Array[ExtResource("3_step")]([SubResource("ReachForestStep")])
quest_giver_id = "Chief"
quest_turn_in_id = ""
is_main_quest = true
