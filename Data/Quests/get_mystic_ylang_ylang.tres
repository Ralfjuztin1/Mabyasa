validation_type = "none"
validation_target = ""

[resource]
script = ExtResource("1_quest")
quest_id = "get_mystic_ylang_ylang"
title = "Find the Mystic Ylang-Ylang"
description = "Explore the Forest, defeat the creature guarding the clearing, and obtain the first Mystic Ylang-Ylang."
rewards = SubResource("MysticYlangReward")
