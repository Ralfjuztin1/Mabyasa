[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://Scripts/Quest/QuestData.gd" id="1_quest"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestReward.gd" id="2_reward"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestStep.gd" id="3_step"]

[sub_resource type="Resource" id="Reward"]
script = ExtResource("2_reward")
exp = 50
gold = 20

[sub_resource type="Resource" id="Objective1"]
script = ExtResource("3_step")
type = "solve_puzzle"
target = "st_elder_records_read"
required_count = 1
validation_type = "none"
validation_target = ""

[sub_resource type="Resource" id="Objective2"]
script = ExtResource("3_step")
type = "interact_object"
target = "st_ancient_well_inspected"
required_count = 1
validation_type = "none"
validation_target = ""

[resource]
script = ExtResource("1_quest")
quest_id = "st_elder_well"
title = "Investigate the Ancient Well"
description = "Learn numbers 7–10, interpret the well records, then inspect the old carvings on the village well."
rewards = SubResource("Reward")
steps = Array[ExtResource("3_step")]([SubResource("Objective1"), SubResource("Objective2")])
quest_giver_id = "second_town_elder"
quest_turn_in_id = ""
is_main_quest = true
