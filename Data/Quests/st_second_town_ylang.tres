[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://Scripts/Quest/QuestData.gd" id="1_quest"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestReward.gd" id="2_reward"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestStep.gd" id="3_step"]

[sub_resource type="Resource" id="FlowerReward"]
script = ExtResource("2_reward")
exp = 80
gold = 30

[sub_resource type="Resource" id="CollectSecondYlang"]
script = ExtResource("3_step")
type = "item_collected"
target = "second_town_ylang_ylang"
required_count = 1

[resource]
script = ExtResource("1_quest")
quest_id = "st_second_town_ylang"
title = "Claim the Second Ylang-Ylang"
description = "With the Number Guardian defeated, collect the second Mystic Ylang-Ylang in Second Town."
rewards = SubResource("FlowerReward")
steps = Array[ExtResource("3_step")]([SubResource("CollectSecondYlang")])
is_main_quest = true
