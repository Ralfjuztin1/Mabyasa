[resource]
script = ExtResource("1_quest")
quest_id = "st_merchant_orders"
title = "Deliver the Merchant's Baskets"
description = "Learn metung, adwa, and atlu. Deliver 1 basket to Berto, 2 to Mila, and 3 to Nena. Return to the merchant for your first clue about the second Mystic Ylang-Ylang."
rewards = SubResource("Reward")
steps = Array[ExtResource("3_step")]([SubResource("Step1"), SubResource("Step2"), SubResource("Step3"), SubResource("Step4"), SubResource("Step5")])
quest_giver_id = "second_town_merchant"
quest_turn_in_id = "second_town_merchant"
is_main_quest = true
