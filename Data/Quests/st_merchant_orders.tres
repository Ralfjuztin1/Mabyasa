[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://Scripts/Quest/QuestData.gd" id="1_quest"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestReward.gd" id="2_reward"]
[ext_resource type="Script" path="res://Scripts/Quest/QuestStep.gd" id="3_step"]

[sub_resource type="Resource" id="Reward"]
script = ExtResource("2_reward")
exp = 25
gold = 10

[sub_resource type="Resource" id="Step1"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Merchant"
required_count = 1
validation_type = "solve_puzzle"
validation_target = "merchant counting lesson"

[sub_resource type="Resource" id="Step2"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Berto"
required_count = 1
validation_type = "interact_object"
validation_target = "Berto"

[sub_resource type="Resource" id="Step3"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Mila"
required_count = 1
validation_type = "interact_object"
validation_target = "Mila"

[sub_resource type="Resource" id="Step4"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Nena"
required_count = 1
validation_type = "interact_object"
validation_target = "Nena"

[sub_resource type="Resource" id="Step5"]
script = ExtResource("3_step")
type = "talk_npc"
target = "Merchant"
required_count = 1
validation_type = "solve_puzzle"
validation_target = "Merchant"

[resource]
script = ExtResource("1_quest")
quest_id = "st_merchant_orders"
title = "Deliver the Merchant's Baskets"
description = "Talk to the merchant to learn metung, adwa, and atlu. Deliver 1 basket to Berto, 2 to Mila, and 3 to Nena, then return to the merchant for a clue."
rewards = SubResource("Reward")
steps = Array[ExtResource("3_step")]([SubResource("Step1"), SubResource("Step2"), SubResource("Step3"), SubResource("Step4"), SubResource("Step5")])
quest_giver_id = "Merchant"
quest_turn_in_id = "Merchant"
is_main_quest = true
