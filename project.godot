;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MABYASA"
run/main_scene="uid://c27kaowi6h0gw"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

SupabaseManager="*uid://bgsvuf0ko0l67"
GameManager="*uid://c0g2g73lnjsd0"
TransitionManager="*uid://cs8yx3ottg1hh"
SaveManager="*uid://b5q4pq0a7jrnb"
TutorialManager="*uid://bocr1ftvonao"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/MarchingSquaresTerrain/plugin.cfg", "res://addons/scatter/plugin.cfg", "res://addons/speechbubble3d/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "blue",
"res://Scenes/": "green",
"res://Scripts/": "orange",
"res://addons/": "gray"
}

