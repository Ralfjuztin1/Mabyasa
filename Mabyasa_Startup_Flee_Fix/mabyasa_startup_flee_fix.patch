diff --git a/Scenes/Battle/BattleScreen.gd b/Scenes/Battle/BattleScreen.gd
--- a/Scenes/Battle/BattleScreen.gd
+++ b/Scenes/Battle/BattleScreen.gd
@@ -1182,5 +1182,6 @@ func _show_action_buttons() -> void:
 	# Fleeing is only offered in normal battles.
 	flee_button.visible = (
 		BattleManager.current_enemy != null
 		and not BattleManager.current_enemy.is_boss
+		and BattleManager.current_enemy.enemy_id != "chief_training"
 	)

diff --git a/Scripts/Battle/BattleManager.gd b/Scripts/Battle/BattleManager.gd
--- a/Scripts/Battle/BattleManager.gd
+++ b/Scripts/Battle/BattleManager.gd
@@ -877,7 +877,12 @@ func flee_battle() -> void:
 	if not battle_active:
 		return
 
+	# Chief's training battle is mandatory and cannot be fled.
+	if current_enemy != null and current_enemy.enemy_id == "chief_training":
+		battle_log.emit("You cannot flee from Chief's training battle.")
+		return
+
 	# Boss battles must use their existing assessment flow.
 	if is_boss_battle:
 		battle_log.emit("You cannot flee from a boss battle.")
 		return

