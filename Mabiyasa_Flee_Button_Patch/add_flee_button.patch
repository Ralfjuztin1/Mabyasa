diff --git a/Scripts/Battle/BattleManager.gd b/Scripts/Battle/BattleManager.gd
index 10cd163..0000000 100644
--- a/Scripts/Battle/BattleManager.gd
+++ b/Scripts/Battle/BattleManager.gd
@@ -15,3 +15,4 @@ signal feedback_requested(result: AnswerResult)
 signal battle_log(message: String)
 signal battle_streak_changed(streak: int, best_streak: int)
 signal battle_ended(victory: bool)
+signal battle_fled
@@ -34,2 +35,3 @@ var awaiting_quiz_response: bool = false
 var awaiting_quiz_response: bool = false
 var awaiting_feedback: bool = false
+var enemy_turn_in_progress: bool = false
@@ -106,5 +108,6 @@ func start_battle(enemy_data: EnemyData) -> void:
 	battle_active = true
 	awaiting_quiz_response = false
 	awaiting_feedback = false
+	enemy_turn_in_progress = false
 
 	current_question = null
@@ -852,6 +855,7 @@ func _enemy_turn() -> void:
 	if not battle_active:
 		return
 
+	enemy_turn_in_progress = true
 
 	await get_tree().create_timer(
 		0.28
@@ -860,3 +864,4 @@ func _enemy_turn() -> void:
 
 	if not battle_active:
+		enemy_turn_in_progress = false
 		return
@@ -895,10 +900,48 @@ func _enemy_turn() -> void:
 	if PlayerProgression.current_hp <= 0:
 
+		enemy_turn_in_progress = false
 		_end_battle(
 			false
 		)
+		return
+
+	enemy_turn_in_progress = false
 
 
 # ============================================================
+# FLEE BATTLE
+# ============================================================
+
+func flee_battle() -> void:
+	if not battle_active:
+		return
+
+	# Boss battles must use their existing win/defeat assessment flow.
+	if is_boss_battle:
+		battle_log.emit("You cannot flee from a boss battle.")
+		return
+
+	# Don't cancel a quiz, feedback result, or a resolving enemy turn.
+	if awaiting_quiz_response or awaiting_feedback or enemy_turn_in_progress:
+		battle_log.emit("Wait until the current action finishes before fleeing.")
+		return
+
+	battle_active = false
+	awaiting_quiz_response = false
+	awaiting_feedback = false
+	enemy_turn_in_progress = false
+	current_question = null
+	_enemy_dead_pending = false
+
+	var fled_from: String = current_enemy.display_name if current_enemy != null else "the encounter"
+	battle_log.emit("You fled from %s." % fled_from)
+	battle_fled.emit()
+
+	GameManager.set_game_state(GameManager.GameState.EXPLORATION)
+	if GameManager.has_method("request_save"):
+		GameManager.request_save()
+
+
+# ============================================================
 # END BATTLE
 # ============================================================
@@ -914,6 +956,7 @@ func _end_battle(
 	battle_active = false
 	awaiting_quiz_response = false
 	awaiting_feedback = false
+	enemy_turn_in_progress = false
 
 	current_question = null
 
